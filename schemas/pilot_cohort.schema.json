{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matpeltier/tiktok-analytics-factory/schemas/pilot_cohort.schema.json",
  "title": "Pilot cohort contract",
  "type": "object",
  "required": [
    "cohort_id",
    "version",
    "approval_status",
    "niche_name",
    "niche_description",
    "platform",
    "languages",
    "geographic_constraints",
    "duration_seconds",
    "publication_window_policy",
    "commercial_content_policy",
    "creator_inclusion_rules",
    "format_inclusion_rules",
    "exclusion_rules",
    "duplicate_policy",
    "minimum_metadata_for_inclusion",
    "performance_observation_policy",
    "pilot_sampling_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "cohort_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "approval_status": {"enum": ["pending_owner_approval", "approved", "retired"]},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"]},
    "niche_name": {"type": "string", "minLength": 1},
    "niche_description": {"type": "string", "minLength": 1},
    "platform": {"const": "tiktok"},
    "languages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "language_policy": {"type": "string"},
    "geographic_constraints": {"type": "string"},
    "duration_seconds": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": {"type": "number", "minimum": 0},
        "max": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "publication_window_policy": {"type": "string", "minLength": 1},
    "commercial_content_policy": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["allowed", "required", "excluded", "allowed_flagged"]},
        "flag_values": {"type": "array", "items": {"type": "string"}},
        "rules": {"type": "string"}
      }
    },
    "creator_inclusion_rules": {"$ref": "#/$defs/ruleList"},
    "format_inclusion_rules": {"$ref": "#/$defs/ruleList"},
    "exclusion_rules": {"$ref": "#/$defs/ruleList"},
    "duplicate_policy": {
      "type": "object",
      "required": ["same_video_id", "direct_reposts", "near_duplicate_detection"],
      "additionalProperties": false,
      "properties": {
        "same_video_id": {"const": "one_source_record"},
        "direct_reposts": {"enum": ["excluded_with_duplicate_of_note", "flagged_creative_duplicate", "treated_independent"]},
        "near_duplicate_detection": {"enum": ["manual_during_pilot", "automated", "none"]},
        "near_duplicate_rule": {"type": "string"}
      }
    },
    "minimum_metadata_for_inclusion": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "performance_observation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_published_at_when_available",
        "store_observed_at_for_every_snapshot",
        "store_creator_identity_when_available",
        "store_follower_count_when_available",
        "store_raw_metrics_unnormalized",
        "raw_metrics"
      ],
      "properties": {
        "store_published_at_when_available": {"const": true},
        "store_observed_at_for_every_snapshot": {"const": true},
        "store_creator_identity_when_available": {"const": true},
        "store_follower_count_when_available": {"const": true},
        "store_raw_metrics_unnormalized": {"const": true},
        "raw_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["views", "likes", "comments", "shares", "saves"]}
        }
      }
    },
    "pilot_sampling_policy": {
      "type": "object",
      "required": [
        "target_size_range",
        "method",
        "stratification",
        "viral_only_sampling_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "target_size_range": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 2,
          "maxItems": 2
        },
        "method": {"type": "string", "minLength": 1},
        "performance_strata": {"type": "array", "items": {"type": "string"}},
        "stratification": {"type": "string"},
        "max_videos_per_creator": {"type": "integer", "minimum": 1},
        "viral_only_sampling_allowed": {"const": false}
      }
    },
    "version_change_triggers": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "ruleList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
